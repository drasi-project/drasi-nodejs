{
    // Prebuilt javascript-node image (Node + npm baked in) so the container
    // build does not depend on installing Node/pnpm/yarn from the npm registry
    // at build time — that step is a common transient point of failure.
    "name": "Drasi Node.js — Curbside Pickup Tutorial",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "29",
            "moby": false
        }
    },
    "postCreateCommand": "bash ../../.devcontainer/curbside-pickup/post-create.sh",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/tutorials/curbside-pickup",
    "runArgs": [
        "--privileged",
        "--init",
        "--ipc=host"
    ],
    // Only the Curbside UI (3000) needs forwarding: the app multiplexes the SSE
    // reaction's routes into a single same-origin /events stream, so everything
    // works over the single forwarded port in Codespaces and local dev
    // containers alike. 5742 (PostgreSQL) and 3309 (MySQL) are optional (psql /
    // mysql from the host). The app listens dual-stack so the forwarder reaches
    // it via IPv4 or IPv6 localhost.
    "forwardPorts": [
        3000,
        5742,
        3309
    ],
    "portsAttributes": {
        "3000": {
            "label": "Curbside UI",
            "onAutoForward": "notify"
        },
        "5742": {
            "label": "PostgreSQL",
            "onAutoForward": "silent"
        },
        "3309": {
            "label": "MySQL",
            "onAutoForward": "silent"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "humao.rest-client"
            ],
            "settings": {
                "editor.formatOnSave": true
            }
        }
    },
    "remoteUser": "node",
    "remoteEnv": {
        "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
    },
    "containerEnv": {
        "POSTGRES_HOST": "localhost",
        "POSTGRES_PORT": "5742",
        "POSTGRES_HOST_PORT": "5742",
        "MYSQL_HOST": "localhost",
        "MYSQL_PORT": "3309",
        "MYSQL_HOST_PORT": "3309",
        "WEB_PORT": "3000"
    }
}
