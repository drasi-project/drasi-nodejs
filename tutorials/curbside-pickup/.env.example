# Copy to .env and adjust if you need non-default ports or credentials.
# The app and the helper scripts read these; sensible defaults are built in, so
# you usually don't need this file at all.

# --- Web UI ---
WEB_HOST=0.0.0.0
WEB_PORT=3000

# --- SSE reaction (internal; multiplexed by the app into /events) ---
SSE_PORT=8081

# --- PostgreSQL / Retail Operations (must match database/docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5742
# Host port the container publishes (used by docker-compose).
POSTGRES_HOST_PORT=5742
POSTGRES_DATABASE=RetailOperations
POSTGRES_USER=drasi_user
POSTGRES_PASSWORD=drasi_password

# --- MySQL / Physical Operations (must match database/docker-compose.yml) ---
MYSQL_HOST=localhost
MYSQL_PORT=3309
# Host port the container publishes (used by docker-compose).
MYSQL_HOST_PORT=3309
MYSQL_DATABASE=PhysicalOperations
MYSQL_USER=drasi_user
MYSQL_PASSWORD=drasi_password
